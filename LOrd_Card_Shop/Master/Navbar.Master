<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Navbar.Master.cs" Inherits="LOrd_Card_Shop.Master.MasterPage" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <title>LOrd Card Shop</title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <script>
        function toggleProfileMenu() {
            var menu = document.getElementById("profileMenu");
            menu.classList.toggle("active");
        }

        document.addEventListener("click", function (event) {
            var profileBtn = document.querySelector(".profile-btn");
            var profileMenu = document.getElementById("profileMenu");

            if (!profileBtn.contains(event.target) && !profileMenu.contains(event.target)) {
                profileMenu.classList.remove("active");
            }
        });

    </script>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }

        .navbar {
            background-color: #2c3e50;
            color: white;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .navbar h1 {
            margin: 0;
            font-size: 22px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            transition: 0.3s;
        }

        .navbar a:hover {
            color: #f39c12;
        }

        .nav-links {
            align-items: center;
            margin-right: auto;
        }

        .username-label {
            margin-right: 10px;
            font-weight: bold;
        }

        .profile-btn {
            cursor: pointer;
            font-weight: bold;
            display: inline-block;
            transition: color 0.3s ease;
        }

        .profile-btn:hover {
            color: #007bff;
        }

        .profile-menu {
            position: absolute;
            right: 0;
            background: white;
            border-radius: 8px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
            width: 200px;
            display: none;
            opacity: 0;
            transform: translateY(-10px);
            transition: opacity 0.3s ease, transform 0.3s ease;
            height: 15vh;
        }

        .profile-menu p {
            margin: 0;
            cursor: pointer;
            padding: 1px;
            margin-left: 20px;
            height: 30px;
            text-align: left;
        }


        .profile-menu p:hover {
            background: #f1f1f1;
        }

        .profile-menu.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        #GuestLoginButton{
            border: none;
            color: white;
            background: #2c3e50;
        }

            #GuestLoginButton:hover {
                cursor: pointer;
            }

        .edit_profile{
            color: black;
        }

        .btn{
            padding: 5px;
            margin-left: 10px;
            margin-top: 10px;
        }

        #SearchBar{
            margin: auto;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <div class="navbar">
            <h1><a href="Home.aspx" style="color: #f39c12;">LOrd Card Shop</a></h1>
            
            <div class="nav-links" id="userSection" style="display: block;" runat="server">
                <a href="OrderCard.aspx">Order Card</a>
                <a href="TransactionHistory.aspx">History</a>
                <a href="Cart.aspx">Cart</a>
            </div>

            <div class="nav-links" id="Div1" style="display: block;" runat="server">
                <a href="ManageCard.aspx">Manage Card</a>
                <a href="TransactionHistory.aspx">View Transaction</a>
                <a href="ViewTransactionReport.aspx">Transaction Report</a>
            </div>
            <asp:TextBox ID="SearchBar" runat="server" AutoPostBack="true" OnTextChanged="SearchBar_TextChanged" placeholder="Search"></asp:TextBox>

            <div class="nav-buttons">
                <asp:Panel ID="DefaultNavbar" runat="server" Visible="false">
                    <asp:Label ID="UsernameLabel" runat="server" CssClass="username-label profile-btn" onclick="toggleProfileMenu()"></asp:Label>
                    <div id="profileMenu" class="profile-menu">
                        <a href="ProfilePage.aspx"><p class="edit_profile">Edit Profile</p></a>
                        <asp:Button ID="LogoutBtn" runat="server" CssClass="btn" Text="LogOut" OnClick="LogoutBtn_Click" />
                    </div>
                </asp:Panel>

                <asp:Panel ID="GuestNavbar" runat="server">
                    <asp:Button ID="GuestLoginButton" runat="server" CssClass="btn" />
                </asp:Panel>
            </div>
        </div>

        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
    </form>
</body>
</html>
